ANTHROPIC_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=
SERPAPI_KEY=
DATABASE_PATH=data/job_radar.db
# Folder holding your real profile (see examples/README.md for the layout). Leave empty
# to run with the fictional example profile in examples/.
PROFILE_SOURCE_DIR=

# LLM provider for the screening pipeline: "anthropic" (default) or "ollama"
LLM_PROVIDER=anthropic
# Only used when LLM_PROVIDER=ollama. One model for both fast/deep roles by
# default -- override OLLAMA_MODEL_FAST / OLLAMA_MODEL_DEEP to split them.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
